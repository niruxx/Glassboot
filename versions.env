# Pinned upstream sources. Every component is built from source; no prebuilt binaries
# are committed to this repository or downloaded at build time.
#
# To bump a version: update the version, then the hash/commit, and note it in the commit.

# GNU GRUB — https://ftp.gnu.org/gnu/grub/  (GPLv3+)
# Verified twice: SHA-256 below, and the detached GPG signature against the GNU keyring.
GRUB_VERSION=2.14
GRUB_SHA256=bc8d3c73535b8838d8c8e2654d73edc4e6ae8c8acdb45d5df5dc9a1547446d43

# wimboot (iPXE project) — https://github.com/ipxe/wimboot  (GPLv2+)
# Used to boot Windows installer ISOs. Pinned to an exact commit.
WIMBOOT_TAG=v2.9.0
WIMBOOT_COMMIT=e5875648bd52a3b915ae54933d9adf8ac763baca
