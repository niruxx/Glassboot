#!/usr/bin/make -f

%:
	dh $@ --buildsystem=cmake+ninja --sourcedirectory=Utility-Source --builddirectory=build

override_dh_auto_test:
	dh_auto_test
	desktop-file-validate packaging/glassboot.desktop

